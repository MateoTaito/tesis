<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE experiments SYSTEM "behaviorspace.dtd">
<experiments>
  <experiment name="Confirmacion" repetitions="30" runMetricsEveryStep="false">
    <setup>setup</setup>
    <go>go</go>
    <timeLimit steps="50000"/>
    <metric>mean [pct-income-report] of tax-payers</metric>
    <metric>mean [risk-aversion] of tax-payers</metric>
    <metric>PIAR_10000</metric>
    <metric>PRA_10000</metric>
    <metric>acum_frauds_detected</metric>
    <metric>acum_frauds_perpretated</metric>
    <metric>acum_frauds_perpretated_all_ags</metric>
    <metric>SS_PIAR</metric>
    <metric>SS_RA</metric>
    <metric>count tax-payers with [sum fraud-detect-hist &gt; 0] / count tax-payers</metric>
    <metric>mean [fiscal-risk-score] of tax-payers</metric>
    <enumeratedValueSet variable="nr-tax-payers">
      <value value="500"/>
    </enumeratedValueSet>
    <enumeratedValueSet variable="nr-auditors">
      <value value="20"/>
    </enumeratedValueSet>
    <enumeratedValueSet variable="actual-audit-rate">
      <value value="0.015"/>
      <value value="0.02"/>
      <value value="0.025"/>
      <value value="0.03"/>
      <value value="0.035"/>
    </enumeratedValueSet>
    <enumeratedValueSet variable="tax-rate">
      <value value="0.27"/>
    </enumeratedValueSet>
    <enumeratedValueSet variable="penalty-rate">
      <value value="1.5"/>
    </enumeratedValueSet>
    <enumeratedValueSet variable="learning-rate">
      <value value="0.05"/>
    </enumeratedValueSet>
    <enumeratedValueSet variable="initial-Risk-aversion">
      <value value="0.5"/>
    </enumeratedValueSet>
    <enumeratedValueSet variable="treshold-influence-income">
      <value value="1.65"/>
    </enumeratedValueSet>
    <enumeratedValueSet variable="tax-payer-audit-selection">
      <value value="&quot;random&quot;"/>
      <value value="&quot;strategic&quot;"/>
    </enumeratedValueSet>
    <enumeratedValueSet variable="period-frauds">
      <value value="1"/>
      <value value="5"/>
    </enumeratedValueSet>
    <enumeratedValueSet variable="institutional-memory">
      <value value="1"/>
    </enumeratedValueSet>
    <enumeratedValueSet variable="audit-noise">
      <value value="0"/>
    </enumeratedValueSet>
    <enumeratedValueSet variable="max-nr-simulated-steps">
      <value value="50000"/>
    </enumeratedValueSet>
    <enumeratedValueSet variable="visual-fraud-spread?">
      <value value="false"/>
    </enumeratedValueSet>
    <enumeratedValueSet variable="start-all-honest?">
      <value value="false"/>
    </enumeratedValueSet>
    <enumeratedValueSet variable="seed-fraud?">
      <value value="false"/>
    </enumeratedValueSet>
  </experiment>
</experiments>
